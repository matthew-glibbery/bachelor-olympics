# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase project — find these under Project Settings → API in the dashboard.
# The anon key is safe to expose to the browser (it's gated by Row Level
# Security); never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groom PIN — server-only (no NEXT_PUBLIC_ prefix) so it never ships in the
# client bundle. Checked via /api/groom/unlock. Pick any digits.
GROOM_PIN=

# Only needed to run scripts/character-gen (the N64 character asset
# pipeline, see its README) — not read anywhere in the app itself.
GEMINI_API_KEY=
